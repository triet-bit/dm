// Instacart Market Basket Analysis — schema of the raw CSV files in data/
// Render at https://dbdiagram.io/d

Project instacart {
  database_type: 'CSV'
  Note: 'Raw snapshot: orders.csv, order_products__prior.csv, order_products__train.csv, products.csv, aisles.csv, departments.csv'
}

Enum eval_set {
  prior [note: '3.214.874 orders — purchase history']
  train [note: '131.209 orders — last order with products']
  test  [note: '75.000 orders — last order, products hidden']
}

Table orders {
  order_id               int      [pk, note: '1 – 3.421.083']
  user_id                int      [not null, note: '206.209 users; no separate users table']
  eval_set               eval_set [not null]
  order_number           int      [not null, note: '1 – 100, order sequence per user']
  order_dow              int      [not null, note: 'day of week, 0 – 6']
  order_hour_of_day      int      [not null, note: '0 – 23']
  days_since_prior_order float    [null, note: '0 – 30 (capped); NULL for first order of each user (206.209 rows)']

  indexes {
    (user_id, order_number) [unique]
  }

  Note: '3.421.083 rows'
}

Table order_products__prior {
  order_id          int [not null]
  product_id        int [not null]
  add_to_cart_order int [not null, note: '1 – 145']
  reordered         int [not null, note: '0 / 1']

  indexes {
    (order_id, product_id) [pk]
  }

  Note: '32.434.489 rows; only orders with eval_set = prior'
}

Table order_products__train {
  order_id          int [not null]
  product_id        int [not null]
  add_to_cart_order int [not null, note: '1 – 80']
  reordered         int [not null, note: '0 / 1']

  indexes {
    (order_id, product_id) [pk]
  }

  Note: '1.384.617 rows; only orders with eval_set = train'
}

Table products {
  product_id    int     [pk, note: '1 – 49.688']
  product_name  varchar [not null]
  aisle_id      int     [not null]
  department_id int     [not null]

  Note: '49.688 rows'
}

Table aisles {
  aisle_id int     [pk, note: '1 – 134']
  aisle    varchar [not null]

  Note: '134 rows'
}

Table departments {
  department_id int     [pk, note: '1 – 21']
  department    varchar [not null]

  Note: '21 rows'
}

Ref: order_products__prior.order_id > orders.order_id
Ref: order_products__train.order_id > orders.order_id
Ref: order_products__prior.product_id > products.product_id
Ref: order_products__train.product_id > products.product_id
Ref: products.aisle_id > aisles.aisle_id
Ref: products.department_id > departments.department_id
